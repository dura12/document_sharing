{
  "name": "@google-docs-clone/server",
  "version": "2.0.0",
  "description": "Real-time collaborative document editing server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run src",
    "seed:users": "tsx src/scripts/seedUsers.ts"
  },
  "keywords": [
    "collaborative",
    "realtime",
    "socket.io",
    "document-editor"
  ],
  "author": "Rami Atrouni",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "mongoose": "^8.9.5",
    "quill-delta": "^5.1.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^4.1.12"
  }
}
